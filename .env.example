# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL externo (não sobe via Docker Compose)
POSTGRES_HOST=SEU_HOST_POSTGRES
POSTGRES_PORT=5432
POSTGRES_DB=systemcommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_REMOTE_DB_PASSWORD

DATABASE_URL=jdbc:postgresql://SEU_HOST_POSTGRES:5432/systemcommerce
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME_REMOTE_DB_PASSWORD

# JWT — gere um valor aleatório (>= 32 bytes). Nunca use o default em produção.
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET_MIN_32_BYTES_LONG!!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_EXPIRATION_MS=900000

# CORS — lista explícita (vírgula). Em produção: https://seu-dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Auth / rate limit
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=30
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN=20
AUTH_RATE_LIMIT_REFRESH=30
AUTH_RATE_LIMIT_FORGOT=10
AUTH_RATE_LIMIT_RESET=10

# Admin seed — senha persistida apenas com BCrypt
# Em produção: ADMIN_SEED_ENABLED=false ou senha forte exclusiva (nunca commitada)
ADMIN_SEED_ENABLED=true
ADMIN_EMAIL=admin@systemcommerce.local
ADMIN_LOGIN=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
