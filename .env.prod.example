# Exemplo para produção — copie para .env.prod e preencha.
# NÃO commite .env.prod. Nunca use valores de exemplo em produção real.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL (usuário do container — pode ser o superuser inicial do volume)
POSTGRES_DB=systemcommerce
POSTGRES_USER=systemcommerce
POSTGRES_PASSWORD=<POSTGRES_PASSWORD_STRONG>
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_LOG_MIN_DURATION_MS=1000

# JDBC da API — preferir role de aplicação com privilégio mínimo
# (após bootstrap, veja scripts/sql/01_create_app_role.sql.example)
DATABASE_URL=jdbc:postgresql://postgres:5432/systemcommerce
DATABASE_USERNAME=<APP_DB_USER>
DATABASE_PASSWORD=<APP_DB_PASSWORD>

# JWT — gere valor aleatório (>= 32 bytes). Obrigatório em prod.
JWT_SECRET=<JWT_SECRET_MIN_32_BYTES_RANDOM>
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — origens HTTPS explícitas (sem wildcard)
CORS_ALLOWED_ORIGINS=https://app.seudominio.com

# Seed admin — mantenha false em produção estável
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=admin@seudominio.com
ADMIN_LOGIN=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Flyway no boot (true) ou rode migrations em job/CI separado (false)
FLYWAY_ENABLED=true

# Pool Hikari / Tomcat
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000
SERVER_CONNECTION_TIMEOUT_MS=20000
SERVER_TOMCAT_MAX_THREADS=200
SHUTDOWN_TIMEOUT=30s

# Rate limit auth
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_REFRESH=20
AUTH_RATE_LIMIT_FORGOT=5
AUTH_RATE_LIMIT_RESET=5

# Actuator — em rede interna pode incluir metrics,prometheus
MANAGEMENT_ENDPOINTS=health,info

# Logs
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
# Opcional (volume montado): LOGGING_FILE_NAME=/var/log/systemcommerce/api.log
